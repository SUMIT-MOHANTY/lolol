# Django Calculator Environment Configuration
# DO NOT commit this file to version control

# =============================================================================
# SECURITY SETTINGS (REQUIRED)
# =============================================================================

# Django SECRET_KEY - Generate a strong random key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-calculator-dev-secret-key-2024-change-in-production

# Debug mode - Set to False in production
DJANGO_DEBUG=True

# Allowed hosts - Comma-separated list of domain names
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Database URL - Leave empty to use SQLite (development)
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# DATABASE_URL=postgres://calc_user:calc_pass@localhost:5432/calculator_db

# =============================================================================
# SECURITY HEADERS (Production Only)
# =============================================================================

# Enable SSL redirect - Set to True when behind HTTPS proxy
# SECURE_SSL_REDIRECT=True

# HSTS settings - Only enable if you fully understand the implications
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# =============================================================================
# LOGGING
# =============================================================================

# Log level - DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
